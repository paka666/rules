name: Download custom files

on:
  schedule:
    - cron: '0 20 * * *'
  workflow_dispatch:
#  push:
#    branches:
#      - main
#    paths:
#      - '.github/workflows/customdown.yml'
#      - 'folder/file.suffix'

jobs:
  update-custom-files:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Download custom files
        run: |
          # 下载并重命名文件
          mkdir -p Folder
          curl -s -L -o folder/file.suffix "url"

      - name: Sync before commit
        run: |
          git fetch origin main
          git reset --hard origin/main
          git clean -fd

      - name: Commit and push if changed
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "[auto] chore: update custom files"
          file_pattern: "folder/file.suffix"
          commit_user_name: github-actions[bot]
          commit_user_email: github-actions[bot]@users.noreply.github.com
