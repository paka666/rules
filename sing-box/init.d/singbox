#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=02

PROG="/usr/bin/singbox/sing-box"
CONFIG_FILE="/usr/bin/singbox/config.json"
WORK_DIR="/usr/bin/singbox"
name="singbox"

validate_config() {
    "$PROG" check -c "$CONFIG_FILE" >/dev/null 2>&1
    return $?
}

start_service() {
    [ -x "$PROG" ] || {
        echo "Error: ${PROG} not found or not executable"
        return 1
    }

    [ -f "$CONFIG_FILE" ] || {
        echo "Error: Config file ${CONFIG_FILE} not found"
        return 1
    }

    if ! validate_config; then
        echo "Error: Invalid configuration file"
        return 1
    fi

    echo "Starting ${name}"
    procd_open_instance ${name}
    procd_set_param command "$PROG" run -c "$CONFIG_FILE" -D "$WORK_DIR"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param limits core="unlimited"
    procd_set_param respawn 3600 5 5
    procd_set_param file "$CONFIG_FILE"
    procd_set_param user root
    procd_close_instance
    echo "${name} started successfully"
}

stop_service() {
    echo "Stopping ${name}"
}

reload_service() {
    if ! validate_config; then
        echo "Error: Invalid configuration, reload aborted"
        return 1
    fi

    echo "Reloading ${name} configuration"
    procd_send_signal ${name} SIGHUP
}

service_triggers() {
    procd_add_file_watch "$CONFIG_FILE"
}
