{
  "log": {
    "disabled": false,
    "level": "info",
    "output": "/var/log/singbox.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_resolver",
        "type": "udp",
        "server": "202.102.213.68",
        "detour": "direct"
      },
      {
        "tag": "dns_remote",
        "type": "https",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "自动选择"
      },
      {
        "tag": "dns_smartdns",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 6053,
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "clash_mode": "全局直连",
        "server": "dns_smartdns"
      },
      {
        "clash_mode": "全局代理",
        "server": "dns_smartdns"
      },
      {
        "rule_set": ["ads"],
        "action": "reject",
        "method": "default",
        "disable_cache": true
      },
      {
        "rule_set": [
          "private",
          "games-cn",
          "games-common",
          "games-noncn",
          "ai-cn",
          "ai-common",
          "ai-noncn",
          "media",
          "network-cn",
          "network-common",
          "network-noncn"
        ],
        "server": "dns_smartdns"
      }
    ],
    "final": "dns_smartdns",
    "strategy": "prefer_ipv4",
    "independent_cache": true,
    "fakeip": {
      "enabled": false,
      "inet4_range": "198.18.0.0/15",
      "inet6_range": "fc00::/18"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/usr/bin/singbox/cache.db",
      "cache_id": "cache_db",
      "store_fakeip": false
    },
    "clash_api": {
      "default_mode": "rule",
      "external_ui": "/usr/bin/singbox/ui/metacubexd",
      "external_controller": "0.0.0.0:9090",
      "secret": ""
    }
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.ntsc.ac.cn",
    "server_port": 123,
    "interval": "30m",
    "detour": "direct"
  },
