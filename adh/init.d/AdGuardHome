#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=01

PROG="/usr/bin/AdGuardHome/AdGuardHome"
name="AdGuardHome"

start_service() {
    [ -x "$PROG" ] || {
        echo "Error: ${PROG} not found or not executable"
        return 1
    }

    echo "Starting ${name}"
    procd_open_instance ${name}
    procd_set_param command "$PROG" -s run --config "/usr/bin/AdGuardHome/AdGuardHome.yaml"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param limits core="unlimited"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_close_instance
    echo "${name} started successfully"
}

stop_service() {
    echo "Stopping ${name}"
}

reload_service() {
    echo "Reloading ${name} configuration"
    procd_send_signal ${name} SIGUSR1
}

service_triggers() {
    procd_add_file_watch "/usr/bin/AdGuardHome/AdGuardHome.yaml"
}
